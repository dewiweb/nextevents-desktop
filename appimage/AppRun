#!/bin/sh
# Point d'entrée AppImage — chaine vers le bundle PyInstaller.
# LD_LIBRARY_PATH : libs système embarquées par linuxdeploy (usr/lib).
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/opt/nextevents/nextevents" "$@"
